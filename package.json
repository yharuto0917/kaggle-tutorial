{
	"name": "kaggle-tutorial",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"preview:full": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply kaggle_tutorial_db --local",
		"db:migrate:remote": "wrangler d1 migrations apply kaggle_tutorial_db --remote"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.9",
		"next": "16.2.6",
		"react": "^19.1.7",
		"react-dom": "^19.1.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.15",
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.43",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"vitest": "^4.1.8",
		"wrangler": "^4.100.0"
	}
}
